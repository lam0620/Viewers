##
# Environment: Default
#
# We're using this to set variables for development.
# Please feel free to delete or modify this file for your own setup.
# Be careful not to commit anything sensitive to source control.
#

# Dicom viewer
PUBLIC_URL=/
APP_CONFIG=config/default.js
USE_HASH_ROUTER=false

# Production environment
# True: must login, false: no need
IS_AUTH=true

USER_MNG_URL=http://192.168.201.80
API_BASE_URL=http://192.168.201.80/api
DCM_API_ENDPOINT=http://192.168.201.80/dicomweb/VHC


# Shown in diagnosis report pdf
ORG_NAME=PHÒNG KHÁM ĐA KHOA QUỐC TẾ XXXX
ORG_ADDR=XXX - XXX, Phường X, Quận X, Tp. Hồ Chí Minh
ORG_TEL=XX XXXX XXXX - XX XXXX XXXX

# Report print tempate
ORG_PRINT_TEMPLATE_LIST=[{"value":"1", "label":"Hiện BSCĐ"}, {"value":"0", "label":"Ẩn BSCĐ"}]
